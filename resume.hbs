<!DOCTYPE html>
<html lang="en" itemscope itemtype="http://schema.org/Person">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" href="https://sandeepdonepudi.in/favicon.ico" type="image/x-icon">
    <title>{{#resume.basics}}{{name}} — Résumé{{/resume.basics}}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <style>{{{css}}}</style>
  </head>

  <body>
    <div class="page">

      <!-- ─── SIDEBAR ─── -->
      <aside class="sidebar">
        {{#resume.basics}}

        <div class="profile">
          <h1 class="name" itemprop="name">{{name}}</h1>
          <p class="role" itemprop="jobTitle">{{label}}</p>
        </div>

        <div class="contact">
          {{#if email}}
          <a href="mailto:{{email}}" class="contact-row" itemprop="email">
            <svg viewBox="0 0 24 24" fill="currentColor" width="13" height="13" aria-hidden="true"><path d="M1.5 8.67v8.58a3 3 0 003 3h15a3 3 0 003-3V8.67l-8.928 5.493a3 3 0 01-3.144 0L1.5 8.67zM22.5 6.908V6.75a3 3 0 00-3-3h-15a3 3 0 00-3 3v.158l9.714 5.978a1.5 1.5 0 001.572 0L22.5 6.908z"/></svg>
            <span>{{email}}</span>
          </a>
          {{/if}}
          {{#if website}}
          <a href="{{website}}" class="contact-row" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" fill="currentColor" width="13" height="13" aria-hidden="true"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/></svg>
            <span>sandeepdonepudi.in</span>
          </a>
          {{/if}}
          {{#if address}}
          <div class="contact-row">
            <svg viewBox="0 0 24 24" fill="currentColor" width="13" height="13" aria-hidden="true"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 110-5 2.5 2.5 0 010 5z"/></svg>
            <span>{{address}}</span>
          </div>
          {{/if}}
        </div>

        <div class="socials">
          {{#each profiles}}
          <a href="{{url}}" class="social-link" target="_blank" rel="noopener noreferrer" title="{{network}}">
            {{{toSocialSvg network}}}
            <span>{{username}}</span>
          </a>
          {{/each}}
        </div>

        {{/resume.basics}}

        {{#if resume.skills}}
        <div class="sidebar-section">
          <h2 class="sidebar-section-title">Skills</h2>
          {{#each resume.skills}}
          <div class="skill-group">
            <span class="skill-cat">{{name}}</span>
            <div class="skill-tags">
              {{#each keywords}}<span class="tag">{{this}}</span>{{/each}}
            </div>
          </div>
          {{/each}}
        </div>
        {{/if}}

        {{#if resume.languages}}
        <div class="sidebar-section">
          <h2 class="sidebar-section-title">Languages</h2>
          {{#each resume.languages}}
          <div class="lang-row">
            <span class="lang-name">{{language}}</span>
            <span class="lang-level">{{fluency}}</span>
          </div>
          {{/each}}
        </div>
        {{/if}}

      </aside>

      <!-- ─── MAIN ─── -->
      <main class="main">

        {{#resume.basics}}
        {{#if summary}}
        <section class="section">
          <h2 class="section-title">About</h2>
          <p class="about-text" itemprop="description">{{summary}}</p>
        </section>
        {{/if}}
        {{/resume.basics}}

        {{#if resume.work}}
        <section class="section">
          <h2 class="section-title">Experience</h2>
          {{#each resume.work}}
          <div class="exp-entry">
            <div class="exp-meta">
              <div class="exp-left">
                <span class="exp-role">{{position}}</span>
                <span class="exp-company">
                  {{#if website}}<a href="{{website}}" target="_blank" rel="noopener">{{company}}</a>{{else}}{{company}}{{/if}}
                  <span class="exp-location">· {{location}}</span>
                </span>
              </div>
              <span class="exp-period">{{startDate}} – {{#if endDate}}{{endDate}}{{else}}Present{{/if}}</span>
            </div>
            {{#if highlights}}
            <ul class="exp-bullets">
              {{#each highlights}}
              <li>{{this}}</li>
              {{/each}}
            </ul>
            {{/if}}
          </div>
          {{/each}}
        </section>
        {{/if}}

        {{#if resume.projects}}
        <section class="section">
          <h2 class="section-title">Projects</h2>
          <div class="project-grid">
            {{#each resume.projects}}
            <div class="project-entry">
              <div class="project-header">
                <span class="project-name">{{displayName}}</span>
                <div class="project-links">
                  {{#if githubUrl}}<a href="{{githubUrl}}" target="_blank" rel="noopener" class="project-link">GitHub ↗</a>{{/if}}
                  {{#if website}}<a href="{{website}}" target="_blank" rel="noopener" class="project-link">Live ↗</a>{{/if}}
                </div>
              </div>
              <p class="project-desc">{{summary}}</p>
              {{#if primaryLanguage}}<span class="tag">{{primaryLanguage}}</span>{{/if}}
            </div>
            {{/each}}
          </div>
          {{#if resume.basics.projects_url}}
          <a href="{{resume.basics.projects_url}}" target="_blank" rel="noopener" class="more-link">More projects →</a>
          {{/if}}
        </section>
        {{/if}}

        {{#if resume.education}}
        <section class="section">
          <h2 class="section-title">Education</h2>
          {{#each resume.education}}
          <div class="edu-entry">
            <div class="edu-meta">
              <div class="edu-left">
                <span class="edu-degree">{{studyType}}, {{area}}</span>
                <span class="edu-inst">{{#if website}}<a href="{{website}}" target="_blank" rel="noopener">{{institution}}</a>{{else}}{{institution}}{{/if}}</span>
              </div>
              <span class="edu-period">{{startDate}} – {{endDate}}</span>
            </div>
          </div>
          {{/each}}
        </section>
        {{/if}}

        <footer class="resume-footer">
          <span class="no-print"><a href="https://resume.sandeepdonepudi.in/resume.pdf">PDF version ↓</a></span>
          <span class="print-only">resume.sandeepdonepudi.in</span>
          <span>Updated {{getBuildDate ''}}</span>
        </footer>

      </main>
    </div>
  </body>
</html>
