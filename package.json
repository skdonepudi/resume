{
  "name": "@skdonepudi/resume",
  "private": true,
  "packageManager": "pnpm@7.8.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run watch:less\" \"node ./serve.js ./resume.json\"",
    "build": "npm run build:less && node ./build.js",
    "build:less": "lessc ./assets/less/theme.less ./assets/css/theme.css",
    "watch:less": "less-watch-compiler ./assets/less ./assets/css theme.less",
    "deploy": "node deploy.js"
  },
  "dependencies": {
    "@types/lodash-es": "^4.17.12",
    "gravatar": "^1.8.2",
    "handlebars": "^4.7.7",
    "lodash-es": "^4.17.21",
    "moment": "^2.29.4",
    "optimist": "^0.6.1",
    "resume-schema": "1.0.0",
    "tarball-extract": "0.0.6"
  },
  "devDependencies": {
    "axios": "^0.27.2",
    "concurrently": "^7.3.0",
    "fs-extra": "^10.1.0",
    "less": "^4.1.3",
    "less-watch-compiler": "^1.16.3",
    "puppeteer": "^15.5.0"
  }
}
